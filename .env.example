# ===== TELEGRAM =====
# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID группы Telegram (суперgroup с включёнными Topics/Форумом)
# Бот должен быть администратором с правом manage_topics
# Получить ID: добавь @getidsbot в группу
GROUP_ID=-1001234567890

# ID канала Telegram для публикации постов
# Бот должен быть администратором в канале
CHANNEL_ID=-1001234567891

# ID администраторов бота (через запятую)
ADMIN_IDS=123456789,987654321

# ===== VK =====
# Токен пользователя VK с правами администратора в сообществах
# Нужны права: wall, groups
# Получить: https://vkhost.github.io/ (выбери wall+groups)
VK_TOKEN=your_vk_user_token_here

# ID сообществ VK для мониторинга (без минуса, через запятую)
VK_COMMUNITY_IDS=123456789,987654321

# ===== НАСТРОЙКИ =====
# Интервал опроса VK в секундах (по умолчанию 5 минут)
POLL_INTERVAL=300

# Сколько последних постов загрузить при первом запуске
INITIAL_POSTS_COUNT=10

# Часовой пояс для кастомного времени публикации (например: Europe/Moscow)
TIMEZONE=Europe/Moscow
